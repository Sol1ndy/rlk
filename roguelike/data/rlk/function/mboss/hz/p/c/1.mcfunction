# Circle r 0.5 (12 points); a point at angle t from forward needs #hzAng >= |t|.
$execute if score #hzAng mb matches 180.. run particle minecraft:dust{color:$(col),scale:$(sc)} ^0 ^0.12 ^-0.5 0 0 0 0 1 force @a[tag=player]
