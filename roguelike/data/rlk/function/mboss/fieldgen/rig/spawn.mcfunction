scoreboard players set @s fgRigT -1
scoreboard players set @s fgRigF 0
scoreboard players set @s fgRigTmp 0
execute if score @s fgRigForm matches 1 run function rlk:mboss/fieldgen/rig/form/dormant
execute if score @s fgRigForm matches 2 run function rlk:mboss/fieldgen/rig/form/cruise
execute if score @s fgRigForm matches 3 run function rlk:mboss/fieldgen/rig/form/field
execute if score @s fgRigForm matches 4 run function rlk:mboss/fieldgen/rig/form/coreup
execute if score @s fgRigForm matches 5 run function rlk:mboss/fieldgen/rig/form/tower
execute if score @s fgRigForm matches 6 run function rlk:mboss/fieldgen/rig/form/laser
execute if score @s fgRigForm matches 7 run function rlk:mboss/fieldgen/rig/form/deployed
function rlk:mboss/fieldgen/rig/look_apply
execute rotated as @s rotated ~ 0 run function rlk:mboss/fieldgen/rig/follow
