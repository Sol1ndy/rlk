scoreboard players set @s bfRigT -1
scoreboard players set @s bfRigF 0
scoreboard players set @s bfRigFlat 0
execute unless score @s bfRigLook matches 0.. run scoreboard players set @s bfRigLook 0
execute unless score @s bfRigTell matches 0.. run scoreboard players set @s bfRigTell 0
execute unless score @s bfRigForm matches 1..2 run scoreboard players set @s bfRigForm 1
function rlk:mboss/butterfly/rig/look_apply
execute if score @s bfRigForm matches 2 run function rlk:mboss/butterfly/rig/form/butterfly
execute unless score @s bfRigForm matches 2 run function rlk:mboss/butterfly/rig/form/human
execute rotated as @s rotated ~ 0 run function rlk:mboss/butterfly/rig/follow
