# From mboss/won during a test (with storage rlk:mboss cur).
$execute if score #mbKilled mb matches 1 run tellraw @a[tag=player] [{text:"[중간보스 테스트] ",color:"#E0703A",bold:true},{text:"처치! 보상 선택이 열렸습니다. ",color:"gray",bold:false},{text:"[다시 하기]",color:"yellow",bold:false,click_event:{action:"suggest_command",command:'/function rlk:mboss/test/start {id:"$(id)"}'}},{text:" ",color:"gray",bold:false},{text:"[로비로]",color:"yellow",bold:false,click_event:{action:"suggest_command",command:'/function rlk:mboss/test/stop'}}]
execute unless score #mbKilled mb matches 1 run tellraw @a[tag=player] [{text:"[중간보스 테스트] ",color:"#E0703A",bold:true},{text:"취소되었습니다(보상 없음). ",color:"gray",bold:false},{text:"[로비로]",color:"yellow",bold:false,click_event:{action:"suggest_command",command:'/function rlk:mboss/test/stop'}}]
