# @s = rig anchor (the boss body, on the floor under the thorax), positioned and rotated where the boss should appear.
# Kills old parts, summons the 49 parts (+ the shadow helper) in the rest pose of the stored form and stance and
# re-applies every stored look (apRig*), the visibility state and the park flag.
function rlk:mboss/apep/rig/init
function rlk:mboss/apep/rig/kill
execute unless score @s apRigForm matches 0..1 run scoreboard players set @s apRigForm 0
execute unless score @s apRigStance matches 0..1 run scoreboard players set @s apRigStance 0
execute unless score @s apRigFace matches 0..4 run scoreboard players set @s apRigFace 0
execute unless score @s apRigCore matches 0..1 run scoreboard players set @s apRigCore 0
execute unless score @s apRigGlow matches 0..1 run scoreboard players set @s apRigGlow 0
execute unless score @s apRigTint matches 0..4 run scoreboard players set @s apRigTint 0
execute unless score @s apRigBright matches 0..1 run scoreboard players set @s apRigBright 0
execute unless score @s apRigHands matches 0..3 run scoreboard players set @s apRigHands 0
execute unless score @s apRigState matches 0..1 run scoreboard players set @s apRigState 0
execute unless score @s apRigPark matches 0..1 run scoreboard players set @s apRigPark 0
