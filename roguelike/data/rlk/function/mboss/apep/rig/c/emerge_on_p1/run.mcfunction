# emerge_on_p1: 24 t, then rotation. @s = rig anchor.
execute if score @s apRigT matches 24.. run return run function rlk:mboss/apep/rig/start/rotation
execute if score @s apRigT matches 0 run return run function rlk:mboss/apep/rig/c/emerge_on_p1/k/0
execute if score @s apRigT matches 1 run return run function rlk:mboss/apep/rig/c/emerge_on_p1/k/1
execute if score @s apRigT matches 2 run return run function rlk:mboss/apep/rig/c/emerge_on_p1/k/2
execute if score @s apRigT matches 3 run return run function rlk:mboss/apep/rig/c/emerge_on_p1/k/3
execute if score @s apRigT matches 4 run return run function rlk:mboss/apep/rig/c/emerge_on_p1/k/4
execute if score @s apRigT matches 5 run return run function rlk:mboss/apep/rig/c/emerge_on_p1/k/5
