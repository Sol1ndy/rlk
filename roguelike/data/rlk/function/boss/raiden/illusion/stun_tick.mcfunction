# boss/raiden/tick, as the stunned boss (rdPat 98): collapse, kneel, rise, move on.
execute if score @s rdTime matches 46 run scoreboard players set @s rdAnim 22
execute if score @s rdTime matches 172 run scoreboard players set @s rdAnim 24
execute if score @s rdTime matches 200.. run function rlk:boss/raiden/finish
