# @s = the boss (the anchor), at its feet. Kills old parts, summons the 40 parts (fixed UUIDs 524c4b4d-544b-4900-8000-0000000000NN) and the
# shadow helper (…40) in the rest pose, re-applies the stored form and looks, and queues idle.
function rlk:boss/tachy/rig/init
function rlk:boss/tachy/rig/kill
execute unless score @s tkRigForm matches 0..2 run scoreboard players set @s tkRigForm 0
execute unless score @s tkRigV matches 0..4 run scoreboard players set @s tkRigV 1
execute unless score @s tkRigE matches 0..4 run scoreboard players set @s tkRigE 2
execute unless score @s tkRigG matches 0..3 run scoreboard players set @s tkRigG 0
execute unless score @s tkRigH matches 0..2 run scoreboard players set @s tkRigH 1
scoreboard players set @s tkRigS 0
scoreboard players set @s tkRigF 0
