# @s = the boss (the anchor), at its feet. Kills old parts, summons the 29 parts (fixed UUIDs 524c4b4d-4852-4400-8000-0000000000NN) and the
# shadow helper (…40) in the rest pose, re-applies the stored form / phase / blade / face / hands, and queues idle.
function rlk:boss/scarlet/rig/init
function rlk:boss/scarlet/rig/kill
execute unless score @s hrRigForm matches 0..1 run scoreboard players set @s hrRigForm 0
execute unless score @s hrRigPh matches 0..1 run scoreboard players set @s hrRigPh 0
execute unless score @s hrRigBl matches 0..4 run scoreboard players set @s hrRigBl 0
execute unless score @s hrRigFc matches 0..2 run scoreboard players set @s hrRigFc 0
execute unless score @s hrRigHR matches 0..2 run scoreboard players set @s hrRigHR 0
execute unless score @s hrRigHL matches 0..2 run scoreboard players set @s hrRigHL 1
execute unless score @s hrRigHat matches 0..4 run scoreboard players set @s hrRigHat 0
execute unless score @s hrRigSw matches 0..2 run scoreboard players set @s hrRigSw 0
execute unless score @s hrRigSc matches 0..2 run scoreboard players set @s hrRigSc 1
execute unless score @s hrRigPr matches 0..0 run scoreboard players set @s hrRigPr 0
execute unless score @s hrRigCu matches 0..2 run scoreboard players set @s hrRigCu 0
execute unless score @s hrRigBo matches 0..2 run scoreboard players set @s hrRigBo 0
scoreboard players set @s hrRigS 0
scoreboard players set @s hrRigF 0
