# Removes the rig and its objectives.
function rlk:boss/apep/rig/kill
kill @e[type=marker,tag=rlk_mb_ap_face]
scoreboard objectives remove apRigC
scoreboard objectives remove apRigT
scoreboard objectives remove apRigF
scoreboard objectives remove apRigY
scoreboard objectives remove apRigState
scoreboard objectives remove apRigForm
scoreboard objectives remove apRigStance
scoreboard objectives remove apRigFace
scoreboard objectives remove apRigCore
scoreboard objectives remove apRigGlow
scoreboard objectives remove apRigTint
scoreboard objectives remove apRigBright
scoreboard objectives remove apRigHands
scoreboard objectives remove apRigPark
scoreboard objectives remove apRigFl
scoreboard objectives remove apRigFy
scoreboard objectives remove apRigQ
scoreboard objectives remove apRigQx
scoreboard objectives remove apRigQy
scoreboard objectives remove apRigQz
scoreboard objectives remove apRigQw
