# @s = the boss (the anchor), at its feet. Kills old parts, summons the 26 parts (fixed UUIDs 524c4b4d-4b4e-4100-8000-0000000000NN) and the
# shadow helper (…40) in the rest pose, re-applies the stored form and looks, and queues idle (idle2 in form p2).
function rlk:boss/arlecchino/rig/init
function rlk:boss/arlecchino/rig/kill
execute unless score @s knRigForm matches 0..1 run scoreboard players set @s knRigForm 0
execute unless score @s knRigWi matches 0..1 run scoreboard players set @s knRigWi 0
execute unless score @s knRigWr matches 0..2 run scoreboard players set @s knRigWr 0
execute unless score @s knRigWl matches 0..2 run scoreboard players set @s knRigWl 0
execute unless score @s knRigGl matches 0..1 run scoreboard players set @s knRigGl 0
execute unless score @s knRigPr matches 0..1 run scoreboard players set @s knRigPr 0
scoreboard players set @s knRigS 0
scoreboard players set @s knRigF 0
