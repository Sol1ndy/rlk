# 원소 표 준비 (load 에서 호출)
# 번호: 0 물리(physical) 1 불(fire) 2 물(water) 3 번개(thunder) 4 얼음(ice) 5 바위(rock) 6 바람(wind) 7 풀(grass) 8 공허(void, 로노바)
# cols[n] = 대미지 숫자 색(col) / 치명타 별 색(sc1 바깥, sc2 안쪽). 색은 여기서 바꾼다
data modify storage rlk:elem cols set value [{col:"#EDEDED",sc1:"#FFFFFF",sc2:"#BDBDBD",name:"물리"},{col:"#FF8A3D",sc1:"#FFC27A",sc2:"#E8552B",name:"불"},{col:"#4FB8FF",sc1:"#A6DCFF",sc2:"#2F7FE0",name:"물"},{col:"#C58BFF",sc1:"#E3C4FF",sc2:"#9A55E8",name:"번개"},{col:"#9FE8F5",sc1:"#DDF8FF",sc2:"#62C3DB",name:"얼음"},{col:"#F2C14E",sc1:"#FFE19A",sc2:"#C9952B",name:"바위"},{col:"#6FE3C1",sc1:"#B8F5E3",sc2:"#3DBB98",name:"바람"},{col:"#A5D94A",sc1:"#D4F29A",sc2:"#6FAE2A",name:"풀"},{col:"#E0365F",sc1:"#FF8FA8",sc2:"#9E1838",name:"공허"}]
# byid.<이름> = 원소 번호(n) + HUD 표시(tag). 영어/한글/원신식 이름 모두 사용 가능
data modify storage rlk:elem byid set value {"physical":{n:0,name:"물리",tag:{text:""}},"물리":{n:0,name:"물리",tag:{text:""}},"fire":{n:1,name:"불",tag:{text:"[불] ",color:"#FF8A3D"}},"불":{n:1,name:"불",tag:{text:"[불] ",color:"#FF8A3D"}},"water":{n:2,name:"물",tag:{text:"[물] ",color:"#4FB8FF"}},"물":{n:2,name:"물",tag:{text:"[물] ",color:"#4FB8FF"}},"thunder":{n:3,name:"번개",tag:{text:"[번개] ",color:"#C58BFF"}},"번개":{n:3,name:"번개",tag:{text:"[번개] ",color:"#C58BFF"}},"ice":{n:4,name:"얼음",tag:{text:"[얼음] ",color:"#9FE8F5"}},"얼음":{n:4,name:"얼음",tag:{text:"[얼음] ",color:"#9FE8F5"}},"rock":{n:5,name:"바위",tag:{text:"[바위] ",color:"#F2C14E"}},"바위":{n:5,name:"바위",tag:{text:"[바위] ",color:"#F2C14E"}},"wind":{n:6,name:"바람",tag:{text:"[바람] ",color:"#6FE3C1"}},"바람":{n:6,name:"바람",tag:{text:"[바람] ",color:"#6FE3C1"}},"grass":{n:7,name:"풀",tag:{text:"[풀] ",color:"#A5D94A"}},"풀":{n:7,name:"풀",tag:{text:"[풀] ",color:"#A5D94A"}},"none":{n:0,name:"물리",tag:{text:""}},"phys":{n:0,name:"물리",tag:{text:""}},"pyro":{n:1,name:"불",tag:{text:"[불] ",color:"#FF8A3D"}},"hydro":{n:2,name:"물",tag:{text:"[물] ",color:"#4FB8FF"}},"lightning":{n:3,name:"번개",tag:{text:"[번개] ",color:"#C58BFF"}},"electro":{n:3,name:"번개",tag:{text:"[번개] ",color:"#C58BFF"}},"cryo":{n:4,name:"얼음",tag:{text:"[얼음] ",color:"#9FE8F5"}},"geo":{n:5,name:"바위",tag:{text:"[바위] ",color:"#F2C14E"}},"anemo":{n:6,name:"바람",tag:{text:"[바람] ",color:"#6FE3C1"}},"dendro":{n:7,name:"풀",tag:{text:"[풀] ",color:"#A5D94A"}},"void":{n:8,name:"공허",tag:{text:"[공허] ",color:"#E0365F"}},"공허":{n:8,name:"공허",tag:{text:"[공허] ",color:"#E0365F"}}}
# rx[n] = 원소 반응 이름/색
data modify storage rlk:elem rx set value [{name:"",col:"white"},{name:"증발",col:"#FFC96B"},{name:"융해",col:"#FFB38A"},{name:"과부하",col:"#FF7FA0"},{name:"초전도",col:"#BDB3FF"},{name:"감전",col:"#DDA0FF"},{name:"빙결",col:"#A8F3FF"},{name:"쇄빙",col:"#E6F7FF"},{name:"확산",col:"#6FE3C1"},{name:"결정",col:"#F2C14E"},{name:"연소",col:"#FF9A2E"},{name:"개화",col:"#7BE36A"},{name:"만개",col:"#B9F06A"},{name:"발화",col:"#FFB04A"},{name:"활성",col:"#C8E64A"},{name:"촉진",col:"#D9A6FF"},{name:"발산",col:"#A5D94A"},{name:"소각",col:"#FF6A4D"},{name:"심연",col:"#6F8BFF"},{name:"단죄",col:"#D96BFF"},{name:"빙참",col:"#BFEFFF"},{name:"공허 결정",col:"#E8B85A"},{name:"진공",col:"#7FE0C8"},{name:"공허 개화",col:"#FF8FC8"},{name:"달 감전",col:"#C9A8FF"},{name:"달 개화",col:"#B8F28A"},{name:"달 결정",col:"#FFE9A8"}]
execute unless data storage rlk:hud inf run data modify storage rlk:hud inf set value {text:""}
data modify storage rlk:hud aura set value []
