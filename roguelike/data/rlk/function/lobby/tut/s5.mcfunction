data modify entity @e[tag=rlk_tutp,limit=1] text set value [{"text": "5. 증폭 반응 · 격변 반응\n", "color": "#7FD3FF", "bold": true}, {"text": "\n증발 (물 ↔ 불): 이번 타격 피해 2배 (물로 때림) / 1.5배 (불로 때림)", "color": "#E6E6E6", "bold": false}, {"text": "\n융해 (불 ↔ 얼음): 이번 타격 피해 2배 (불로 때림) / 1.5배 (얼음으로 때림)", "color": "#E6E6E6", "bold": false}, {"text": "\n과부하 (불 + 번개): 주변 4칸이 폭발해 불 피해, 적을 살짝 띄움", "color": "#E6E6E6", "bold": false}, {"text": "\n초전도 (얼음 + 번개): 주변 4칸 얼음 피해 + 12초 동안 받는 물리 피해 +40%", "color": "#E6E6E6", "bold": false}, {"text": "\n감전 (물 + 번개): 두 원소가 함께 붙어 있는 동안 1초마다 번개 피해", "color": "#E6E6E6", "bold": false}, {"text": "\n빙결 (물 + 얼음): 적이 얼어붙어 잠깐 움직이지 못함 (보스는 면역)", "color": "#E6E6E6", "bold": false}, {"text": "\n쇄빙 (빙결 + 바위): 얼음을 깨며 큰 물리 피해", "color": "#E6E6E6", "bold": false}, {"text": "\n확산 (바람 + 불 · 물 · 번개 · 얼음): 주변 4칸에 그 원소 피해 + 주변 적에게 원소를 퍼뜨림", "color": "#E6E6E6", "bold": false}, {"text": "\n결정 (바위 + 불 · 물 · 번개 · 얼음): 결정 조각이 떨어지고, 주우면 그 원소의 방어막", "color": "#E6E6E6", "bold": false}, {"text": "\n     (결정 방어막은 같은 원소의 피해를 훨씬 잘 막습니다)", "color": "#E6E6E6", "bold": false}]
