# @s = player. The weapon model itself glows yellow-white (until beat/wglow_off).
scoreboard players set @s pbGlow 1
execute if score @s pmWModel matches 1 if score @s pmRigChar = #charN tmp run data merge entity @e[tag=rlk_pm_weapon,limit=1] {shadow_strength:0.99f,brightness:{sky:15,block:15},item:{components:{"minecraft:item_model":"rlk:player_motion/weapons/spear_glow"}}}
