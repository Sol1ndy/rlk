# Video-authored Skirk VFX. @s = player; position = actual body; rotation = locked clip heading.
# pmTick is the animation timeline, 20 ticks per reference second.
execute if score @s pmTick matches 12 run function rlk:char/motion/skirk_fx/physical_5/t012
execute if score @s pmTick matches 13 run function rlk:char/motion/skirk_fx/physical_5/t013
execute if score @s pmTick matches 14 run function rlk:char/motion/skirk_fx/physical_5/t014
