# Video-authored Skirk VFX. @s = player; position = actual body; rotation = locked clip heading.
# pmTick is the animation timeline, 20 ticks per reference second.
execute if score @s pmTick matches 0 run function rlk:char/motion/skirk_fx/infused_5/t000
execute if score @s pmTick matches 2 run function rlk:char/motion/skirk_fx/infused_5/t002
execute if score @s pmTick matches 9 run function rlk:char/motion/skirk_fx/infused_5/t009
execute if score @s pmTick matches 10 run function rlk:char/motion/skirk_fx/infused_5/t010
execute if score @s pmTick matches 11 run function rlk:char/motion/skirk_fx/infused_5/t011
execute if score @s pmTick matches 12 run function rlk:char/motion/skirk_fx/infused_5/t012
execute if score @s pmTick matches 13 run function rlk:char/motion/skirk_fx/infused_5/t013
