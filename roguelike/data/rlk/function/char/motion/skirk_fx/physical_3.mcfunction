# Video-authored Skirk VFX. @s = player; position = actual body; rotation = locked clip heading.
# pmTick is the animation timeline, 20 ticks per reference second.
execute if score @s pmTick matches 2 run function rlk:char/motion/skirk_fx/physical_3/t002
execute if score @s pmTick matches 3 run function rlk:char/motion/skirk_fx/physical_3/t003
execute if score @s pmTick matches 4 run function rlk:char/motion/skirk_fx/physical_3/t004
execute if score @s pmTick matches 7 run function rlk:char/motion/skirk_fx/physical_3/t007
execute if score @s pmTick matches 8 run function rlk:char/motion/skirk_fx/physical_3/t008
execute if score @s pmTick matches 9 run function rlk:char/motion/skirk_fx/physical_3/t009
