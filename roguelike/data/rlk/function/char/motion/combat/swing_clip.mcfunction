# Generated by build_player_rig.mjs (@s player, from player/swing/tick): returns 0 when the character is a rig
# character whose normal-attack clip (active.normal, physical_/infused_) is no longer playing: finished, stopped, aborted
# or replaced by a dash, skill, burst or put-away clip. Other characters have no clip and always return 1.
execute if score #charN tmp matches 5 unless data storage rlk:player_motion active{normal:1b} run return 0
execute if score #charN tmp matches 3 unless data storage rlk:player_motion active{normal:1b} run return 0
execute if score #charN tmp matches 6 unless data storage rlk:player_motion active{normal:1b} run return 0
return 1
