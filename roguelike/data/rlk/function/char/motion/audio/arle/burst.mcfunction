# Vanilla-only layered combat sound; generated by tools/build_player_audio.py.
# Frame timing follows the animation clock, including attack-speed changes.
# dark_charge
execute if score @s pmTick matches 0 run playsound minecraft:block.respawn_anchor.charge player @s ~ ~ ~ 0.26 0.58 0
# raised_hand_fire
execute if score @s pmTick matches 18 run playsound minecraft:item.firecharge.use player @s ~ ~ ~ 0.23 0.62 0
# gathering_pressure
execute if score @s pmTick matches 30 run playsound minecraft:entity.breeze.charge player @s ~ ~ ~ 0.17 0.68 0
# cross_release_whoosh
execute if score @s pmTick matches 37 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.58 0.55 0
# main_blast_body
execute if score @s pmTick matches 40 run playsound minecraft:entity.generic.explode player @s ~ ~ ~ 0.8 0.67 0
# main_blast_low_pressure
execute if score @s pmTick matches 40 run playsound minecraft:item.mace.smash_ground_heavy player @s ~ ~ ~ 0.34 0.73 0
# infernal_fire_release
execute if score @s pmTick matches 40 run playsound minecraft:entity.blaze.shoot player @s ~ ~ ~ 0.45 0.59 0
# hot_air_decay
execute if score @s pmTick matches 42 run playsound minecraft:block.fire.extinguish player @s ~ ~ ~ 0.24 0.64 0
# last_ash_fragment
execute if score @s pmTick matches 47 run playsound minecraft:block.heavy_core.hit player @s ~ ~ ~ 0.13 0.57 0
