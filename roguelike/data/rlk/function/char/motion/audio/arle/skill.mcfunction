# Vanilla-only layered combat sound; generated by tools/build_player_audio.py.
# Frame timing follows the animation clock, including attack-speed changes.
# ash_entry_ignition
execute if score @s pmTick matches 0 run playsound minecraft:item.firecharge.use player @s ~ ~ ~ 0.26 0.64 0
# entry_rush_body
execute if score @s pmTick matches 4 run playsound minecraft:entity.breeze.slide player @s ~ ~ ~ 0.18 0.68 0
# entry_scythe_rush
execute if score @s pmTick matches 7 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.48 0.58 0
# entry_scythe_edge
execute if score @s pmTick matches 7 run playsound minecraft:item.spear.attack player @s ~ ~ ~ 0.23 0.89 0
# thorn_flare
execute if score @s pmTick matches 13 run playsound minecraft:item.firecharge.use player @s ~ ~ ~ 0.26 0.58 0
# thorn_eruption_body
execute if score @s pmTick matches 14 run playsound minecraft:entity.generic.explode player @s ~ ~ ~ 0.34 0.77 0
# thorn_flame_release
execute if score @s pmTick matches 14 run playsound minecraft:entity.blaze.shoot player @s ~ ~ ~ 0.3 0.63 0
# ground_pressure_contact
execute if score @s pmTick matches 14 run playsound minecraft:block.heavy_core.hit player @s ~ ~ ~ 0.17 0.65 0
# ash_decay
execute if score @s pmTick matches 17 run playsound minecraft:block.fire.extinguish player @s ~ ~ ~ 0.18 0.75 0
