# Vanilla-only layered combat sound; generated by tools/build_player_audio.py.
# Frame timing follows the animation clock, including attack-speed changes.
# vault_takeoff_air
execute if score @s pmTick matches 0 run playsound minecraft:entity.breeze.slide player @s ~ ~ ~ 0.11 0.92 0
# shaft_cutting_rush
execute if score @s pmTick matches 3 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.494 0.58 0
# bloodfire_arc
execute if score @s pmTick matches 4 run playsound minecraft:item.firecharge.use player @s ~ ~ ~ 0.258 0.58 0
# blade_edge_contact
execute if score @s pmTick matches 6 run playsound minecraft:item.spear.attack player @s ~ ~ ~ 0.206 0.91 0
# bloodfire_cut_tail
execute if score @s pmTick matches 8 run playsound minecraft:block.fire.extinguish player @s ~ ~ ~ 0.124 0.86 0
