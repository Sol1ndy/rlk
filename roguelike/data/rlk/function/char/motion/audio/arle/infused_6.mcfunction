# Vanilla-only layered combat sound; generated by tools/build_player_audio.py.
# Frame timing follows the animation clock, including attack-speed changes.
# shaft_cutting_rush
execute if score @s pmTick matches 4 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.528 0.55 0
# bloodfire_arc
execute if score @s pmTick matches 5 run playsound minecraft:item.firecharge.use player @s ~ ~ ~ 0.275 0.55 0
# blade_edge_contact
execute if score @s pmTick matches 7 run playsound minecraft:item.spear.attack player @s ~ ~ ~ 0.22 0.88 0
# bloodfire_cut_tail
execute if score @s pmTick matches 9 run playsound minecraft:block.fire.extinguish player @s ~ ~ ~ 0.132 0.72 0
