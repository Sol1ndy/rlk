# Vanilla-only layered combat sound; generated by tools/build_player_audio.py.
# Frame timing follows the animation clock, including attack-speed changes.
# shaft_cutting_rush
execute if score @s pmTick matches 1 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.48 0.61 0
# bloodfire_arc
execute if score @s pmTick matches 2 run playsound minecraft:item.firecharge.use player @s ~ ~ ~ 0.25 0.61 0
# blade_edge_contact
execute if score @s pmTick matches 4 run playsound minecraft:item.spear.attack player @s ~ ~ ~ 0.2 0.96 0
# bloodfire_cut_tail
execute if score @s pmTick matches 6 run playsound minecraft:block.fire.extinguish player @s ~ ~ ~ 0.12 0.86 0
