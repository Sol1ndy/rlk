# Vanilla-only layered combat sound; generated by tools/build_player_audio.py.
# Frame timing follows the animation clock, including attack-speed changes.
# glide-release
execute if score @s pmTick matches 1 run playsound minecraft:entity.breeze.slide player @s ~ ~ ~ 0.21 0.73 0
# settle-sweep
execute if score @s pmTick matches 4 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.3 0.81 0
