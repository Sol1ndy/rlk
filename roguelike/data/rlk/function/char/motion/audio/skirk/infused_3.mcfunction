# Vanilla-only layered combat sound; generated by tools/build_player_audio.py.
# Frame timing follows the animation clock, including attack-speed changes.
# cold-air-draw
execute if score @s pmTick matches 3 run playsound minecraft:entity.breeze.slide player @s ~ ~ ~ 0.085 0.8 0
# blade-acceleration
execute if score @s pmTick matches 3 run playsound minecraft:item.trident.throw player @s ~ ~ ~ 0.19 0.86 0
# broad-cut
execute if score @s pmTick matches 5 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.41 0.88 0
# blade-acceleration
execute if score @s pmTick matches 6 run playsound minecraft:item.trident.throw player @s ~ ~ ~ 0.19 0.95 0
# broad-cut
execute if score @s pmTick matches 8 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.41 0.97 0
