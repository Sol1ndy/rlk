# Vanilla-only layered combat sound; generated by tools/build_player_audio.py.
# Frame timing follows the animation clock, including attack-speed changes.
# dive-inhale
execute if score @s pmTick matches 0 run playsound minecraft:entity.breeze.slide player @s ~ ~ ~ 0.22 0.64 0
# dive-draw
execute if score @s pmTick matches 5 run playsound minecraft:item.trident.throw player @s ~ ~ ~ 0.29 0.75 0
# dash-pressure
execute if score @s pmTick matches 8 run playsound minecraft:entity.breeze.wind_burst player @s ~ ~ ~ 0.44 0.83 0
# rift-transition
execute if score @s pmTick matches 8 run playsound minecraft:entity.enderman.teleport player @s ~ ~ ~ 0.18 0.69 0
