# Vanilla-only layered combat sound; generated by tools/build_player_audio.py.
# Frame timing follows the animation clock, including attack-speed changes.
# empowerment-draw
execute if score @s pmTick matches 0 run playsound minecraft:block.respawn_anchor.charge player @s ~ ~ ~ 0.22 0.58 0
# compressed-crystal
execute if score @s pmTick matches 3 run playsound minecraft:block.amethyst_block.resonate player @s ~ ~ ~ 0.11 0.64 0
# somersault-wind
execute if score @s pmTick matches 7 run playsound minecraft:entity.breeze.slide player @s ~ ~ ~ 0.28 0.69 0
# ring-cut
execute if score @s pmTick matches 10 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.45 0.68 0
# empowerment-pressure
execute if score @s pmTick matches 10 run playsound minecraft:entity.breeze.wind_burst player @s ~ ~ ~ 0.44 0.68 0
# empowerment-tail
execute if score @s pmTick matches 13 run playsound minecraft:block.amethyst_block.resonate player @s ~ ~ ~ 0.1 0.74 0
