# Vanilla-only layered combat sound; generated by tools/build_player_audio.py.
# Frame timing follows the animation clock, including attack-speed changes.
# lift-air
execute if score @s pmTick matches 6 run playsound minecraft:entity.breeze.slide player @s ~ ~ ~ 0.05 1.6 0
# point-down-tap
execute if score @s pmTick matches 11 run playsound minecraft:item.armor.equip_diamond player @s ~ ~ ~ 0.16 1.7 0
# wheel-whoosh
execute if score @s pmTick matches 24 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.16 1.5 0
# raise-flick
execute if score @s pmTick matches 30 run playsound minecraft:entity.breeze.slide player @s ~ ~ ~ 0.12 1.4 0
# float-shimmer
execute if score @s pmTick matches 38 run playsound minecraft:block.amethyst_block.resonate player @s ~ ~ ~ 0.07 1.4 0
# float-turn
execute if score @s pmTick matches 40 run playsound minecraft:entity.breeze.slide player @s ~ ~ ~ 0.06 1.9 0
# dissolve-breath
execute if score @s pmTick matches 43 run playsound minecraft:entity.breeze.slide player @s ~ ~ ~ 0.04 2 0
# back-reform-shimmer
execute if score @s pmTick matches 48 run playsound minecraft:block.enchantment_table.use player @s ~ ~ ~ 0.12 1.6 0
