# Vanilla-only layered combat sound; generated by tools/build_player_audio.py.
# Frame timing follows the animation clock, including attack-speed changes.
# shell-charge
execute if score @s pmTick matches 0 run playsound minecraft:block.respawn_anchor.charge player @s ~ ~ ~ 0.18 0.63 0
# crystal-pressure
execute if score @s pmTick matches 3 run playsound minecraft:block.amethyst_block.resonate player @s ~ ~ ~ 0.09 0.68 0
# upward-draw
execute if score @s pmTick matches 6 run playsound minecraft:item.trident.throw player @s ~ ~ ~ 0.23 0.74 0
# shell-opening
execute if score @s pmTick matches 9 run playsound minecraft:entity.breeze.wind_burst player @s ~ ~ ~ 0.39 0.74 0
# ring-expansion
execute if score @s pmTick matches 9 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.31 0.69 0
# settled-crystal-tail
execute if score @s pmTick matches 13 run playsound minecraft:block.amethyst_block.resonate player @s ~ ~ ~ 0.085 0.67 0
