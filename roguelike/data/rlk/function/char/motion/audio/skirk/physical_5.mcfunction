# Vanilla-only layered combat sound; generated by tools/build_player_audio.py.
# Frame timing follows the animation clock, including attack-speed changes.
# finisher-air-draw
execute if score @s pmTick matches 8 run playsound minecraft:entity.breeze.slide player @s ~ ~ ~ 0.12 0.72 0
# blade-acceleration
execute if score @s pmTick matches 11 run playsound minecraft:item.trident.throw player @s ~ ~ ~ 0.24 0.86 0
# broad-cut
execute if score @s pmTick matches 13 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.62 0.65 0
