# Vanilla-only layered combat sound; generated by tools/build_player_audio.py.
# Frame timing follows the animation clock, including attack-speed changes.
# coat flutter
execute if score @s pmTick matches 1 run playsound minecraft:item.armor.equip_leather player @s ~ ~ ~ 0.16 1.35 0
# gold rose shimmer
execute if score @s pmTick matches 2 run playsound minecraft:block.amethyst_block.chime player @s ~ ~ ~ 0.22 1.8 0
