# Vanilla-only layered combat sound; generated by tools/build_player_audio.py.
# Frame timing follows the animation clock, including attack-speed changes.
# pivot step
execute if score @s pmTick matches 2 run playsound minecraft:block.stone.step player @s ~ ~ ~ 0.2 1.1 0
# parasol materialises (S1)
execute if score @s pmTick matches 4 run playsound minecraft:block.amethyst_block.chime player @s ~ ~ ~ 0.45 1.6 0
# frill rattle (S1)
execute if score @s pmTick matches 4 run playsound minecraft:item.armor.equip_leather player @s ~ ~ ~ 0.35 1.5 0
# low ferrule sweep
execute if score @s pmTick matches 6 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.25 1.3 0
# swing-up whoosh (S2)
execute if score @s pmTick matches 9 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.5 0.8 0
# swing-up air (S2)
execute if score @s pmTick matches 9 run playsound minecraft:item.trident.throw player @s ~ ~ ~ 0.3 1.4 0
# overhead spin (S3)
execute if score @s pmTick matches 12 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.3 1.2 0
# aim engages, low swell (S3)
execute if score @s pmTick matches 12 run playsound minecraft:block.respawn_anchor.charge player @s ~ ~ ~ 0.22 1.7 0
# drop into the stance
execute if score @s pmTick matches 15 run playsound minecraft:item.armor.equip_leather player @s ~ ~ ~ 0.25 0.9 0
