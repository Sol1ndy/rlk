# Vanilla-only layered combat sound; generated by tools/build_player_audio.py.
# Frame timing follows the animation clock, including attack-speed changes.
# wind-up grip
execute if score @s pmTick matches 2 run playsound minecraft:item.armor.equip_leather player @s ~ ~ ~ 0.18 1.1 0
# heavy whoosh
execute if score @s pmTick matches 7 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.5 0.62 0
# swing weight
execute if score @s pmTick matches 8 run playsound minecraft:item.trident.throw player @s ~ ~ ~ 0.22 0.62 0
# edge shing
execute if score @s pmTick matches 10 run playsound minecraft:item.spear.attack player @s ~ ~ ~ 0.22 0.85 0
# head thud
execute if score @s pmTick matches 13 run playsound minecraft:item.mace.smash_ground player @s ~ ~ ~ 0.38 0.9 0
# thud body
execute if score @s pmTick matches 13 run playsound minecraft:block.heavy_core.hit player @s ~ ~ ~ 0.2 0.65 0
