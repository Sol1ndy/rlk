# Vanilla-only layered combat sound; generated by tools/build_player_audio.py.
# Frame timing follows the animation clock, including attack-speed changes.
# tip leaves the floor
execute if score @s pmTick matches 4 run playsound minecraft:entity.breeze.slide player @s ~ ~ ~ 0.08 1.5 0
# onto the shoulder
execute if score @s pmTick matches 7 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.2 0.7 0
# wheel bottom whoosh
execute if score @s pmTick matches 19 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.26 0.55 0
# wheel weight
execute if score @s pmTick matches 19 run playsound minecraft:item.trident.throw player @s ~ ~ ~ 0.12 0.6 0
# wheel top air
execute if score @s pmTick matches 25 run playsound minecraft:entity.breeze.slide player @s ~ ~ ~ 0.12 1.2 0
# regrip
execute if score @s pmTick matches 30 run playsound minecraft:item.armor.equip_iron player @s ~ ~ ~ 0.22 0.8 0
# plant clank
execute if score @s pmTick matches 36 run playsound minecraft:item.trident.hit_ground player @s ~ ~ ~ 0.4 0.8 0
# plant ring
execute if score @s pmTick matches 37 run playsound minecraft:block.chain.place player @s ~ ~ ~ 0.28 0.7 0
# glow-up
execute if score @s pmTick matches 40 run playsound minecraft:block.amethyst_block.chime player @s ~ ~ ~ 0.25 1.6 0
# dissolve sparkle
execute if score @s pmTick matches 42 run playsound minecraft:entity.firework_rocket.twinkle player @s ~ ~ ~ 0.08 1.6 0
# back speck
execute if score @s pmTick matches 48 run playsound minecraft:block.amethyst_block.resonate player @s ~ ~ ~ 0.14 1.3 0
# back silhouette shimmer
execute if score @s pmTick matches 53 run playsound minecraft:block.enchantment_table.use player @s ~ ~ ~ 0.1 1.6 0
