# Vanilla-only layered combat sound; generated by tools/build_player_audio.py.
# Frame timing follows the animation clock, including attack-speed changes.
# parasol appears
execute if score @s pmTick matches 1 run playsound minecraft:block.amethyst_block.chime player @s ~ ~ ~ 0.25 1.8 0
# twirl swish
execute if score @s pmTick matches 2 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.2 1.7 0
# canopy snaps open (A1 cloth)
execute if score @s pmTick matches 5 run playsound minecraft:item.armor.equip_leather player @s ~ ~ ~ 0.55 1.6 0
# canopy mechanism whir (A1)
execute if score @s pmTick matches 5 run playsound minecraft:item.crossbow.loading_middle player @s ~ ~ ~ 0.35 1.6 0
# flare glitter (A1)
execute if score @s pmTick matches 5 run playsound minecraft:block.amethyst_block.chime player @s ~ ~ ~ 0.3 1.6 0
