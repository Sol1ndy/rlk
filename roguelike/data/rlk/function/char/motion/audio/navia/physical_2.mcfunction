# Vanilla-only layered combat sound; generated by tools/build_player_audio.py.
# Frame timing follows the animation clock, including attack-speed changes.
# re-cock drag
execute if score @s pmTick matches 2 run playsound minecraft:block.chain.hit player @s ~ ~ ~ 0.15 1.2 0
# rising rush
execute if score @s pmTick matches 4 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.46 0.8 0
# swing weight
execute if score @s pmTick matches 5 run playsound minecraft:item.trident.throw player @s ~ ~ ~ 0.16 0.78 0
# edge
execute if score @s pmTick matches 7 run playsound minecraft:item.spear.attack player @s ~ ~ ~ 0.15 0.78 0
# crystal spikes
execute if score @s pmTick matches 7 run playsound minecraft:block.amethyst_cluster.place player @s ~ ~ ~ 0.38 0.9 0
# spike thump
execute if score @s pmTick matches 8 run playsound minecraft:block.heavy_core.hit player @s ~ ~ ~ 0.18 0.7 0
# overhead carry
execute if score @s pmTick matches 8 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.2 1.05 0
# skip-hop cloth
execute if score @s pmTick matches 9 run playsound minecraft:item.armor.equip_leather player @s ~ ~ ~ 0.16 1.2 0
# landing
execute if score @s pmTick matches 12 run playsound minecraft:block.stone.step player @s ~ ~ ~ 0.3 0.9 0
