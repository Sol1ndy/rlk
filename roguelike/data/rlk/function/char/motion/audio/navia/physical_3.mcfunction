# Vanilla-only layered combat sound; generated by tools/build_player_audio.py.
# Frame timing follows the animation clock, including attack-speed changes.
# halberd swung back
execute if score @s pmTick matches 1 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.18 0.55 0
# tip-scrape click
execute if score @s pmTick matches 2 run playsound minecraft:block.stone.hit player @s ~ ~ ~ 0.3 1.35 0
# metal tip on stone
execute if score @s pmTick matches 2 run playsound minecraft:item.trident.hit_ground player @s ~ ~ ~ 0.14 1.5 0
# sliding lunge step
execute if score @s pmTick matches 2 run playsound minecraft:block.stone.step player @s ~ ~ ~ 0.18 0.85 0
# drag scrape
execute if score @s pmTick matches 3 run playsound minecraft:block.grindstone.use player @s ~ ~ ~ 0.07 1.7 0
# whip up
execute if score @s pmTick matches 4 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.22 0.75 0
# swing down
execute if score @s pmTick matches 6 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.2 0.6 0
# planted thunk
execute if score @s pmTick matches 7 run playsound minecraft:block.heavy_core.hit player @s ~ ~ ~ 0.3 1.1 0
