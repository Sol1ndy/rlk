# Vanilla-only layered combat sound; generated by tools/build_player_audio.py.
# Frame timing follows the animation clock, including attack-speed changes.
# parasol appears
execute if score @s pmTick matches 0 run playsound minecraft:block.amethyst_block.chime player @s ~ ~ ~ 0.3 1.6 0
# parasol drawn
execute if score @s pmTick matches 1 run playsound minecraft:item.armor.equip_leather player @s ~ ~ ~ 0.3 1.3 0
# swing up
execute if score @s pmTick matches 2 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.15 1.7 0
# load shimmer
execute if score @s pmTick matches 4 run playsound minecraft:block.amethyst_block.chime player @s ~ ~ ~ 0.25 1.9 0
# load
execute if score @s pmTick matches 4 run playsound minecraft:item.crossbow.loading_middle player @s ~ ~ ~ 0.35 1.3 0
# load tone
execute if score @s pmTick matches 5 run playsound minecraft:block.note_block.chime player @s ~ ~ ~ 0.12 0.5 0
# cocked
execute if score @s pmTick matches 6 run playsound minecraft:item.crossbow.loading_end player @s ~ ~ ~ 0.3 1.5 0
# shoulder swing
execute if score @s pmTick matches 7 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.18 1.3 0
# whip to aim
execute if score @s pmTick matches 9 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.35 1.4 0
# shot body
execute if score @s pmTick matches 10 run playsound minecraft:entity.firework_rocket.blast player @s ~ ~ ~ 0.6 0.8 0
# shot crack
execute if score @s pmTick matches 10 run playsound minecraft:item.crossbow.shoot player @s ~ ~ ~ 0.45 0.65 0
# shot tail
execute if score @s pmTick matches 11 run playsound minecraft:entity.generic.explode player @s ~ ~ ~ 0.18 1.7 0
# launch
execute if score @s pmTick matches 12 run playsound minecraft:entity.breeze.wind_burst player @s ~ ~ ~ 0.45 0.85 0
# eruption
execute if score @s pmTick matches 12 run playsound minecraft:block.amethyst_cluster.break player @s ~ ~ ~ 0.45 0.8 0
# up-swing
execute if score @s pmTick matches 13 run playsound minecraft:entity.player.attack.sweep player @s ~ ~ ~ 0.3 0.7 0
# flip whirl
execute if score @s pmTick matches 14 run playsound minecraft:item.trident.riptide_1 player @s ~ ~ ~ 0.2 1.4 0
# eruption crash
execute if score @s pmTick matches 15 run playsound minecraft:block.amethyst_block.break player @s ~ ~ ~ 0.3 0.9 0
# canopy opens
execute if score @s pmTick matches 21 run playsound minecraft:item.armor.equip_elytra player @s ~ ~ ~ 0.4 1.3 0
# float tone low
execute if score @s pmTick matches 23 run playsound minecraft:block.note_block.flute player @s ~ ~ ~ 0.1 0.54 0
# float tone high
execute if score @s pmTick matches 23 run playsound minecraft:block.note_block.flute player @s ~ ~ ~ 0.08 0.81 0
# landing
execute if score @s pmTick matches 31 run playsound minecraft:block.stone.step player @s ~ ~ ~ 0.35 0.9 0
# landing cloth
execute if score @s pmTick matches 31 run playsound minecraft:item.armor.equip_leather player @s ~ ~ ~ 0.22 1.1 0
# canopy twirl
execute if score @s pmTick matches 32 run playsound minecraft:entity.breeze.slide player @s ~ ~ ~ 0.12 1.3 0
# parasol closes
execute if score @s pmTick matches 33 run playsound minecraft:item.crossbow.loading_end player @s ~ ~ ~ 0.28 1.6 0
# parasol dissolves
execute if score @s pmTick matches 34 run playsound minecraft:block.amethyst_block.resonate player @s ~ ~ ~ 0.2 1.6 0
# halberd re-forms
execute if score @s pmTick matches 35 run playsound minecraft:item.armor.equip_iron player @s ~ ~ ~ 0.25 1.2 0
# re-form glint
execute if score @s pmTick matches 37 run playsound minecraft:block.amethyst_block.chime player @s ~ ~ ~ 0.15 1.4 0
