data modify storage rlk:chars registry.ronova.info.extra set value {name:"공허 반응",lore:[{text:"",color:"gray",italic:false,extra:[{text:"불 · 소각: 대상의 잠식을 모두 태워 큰 불 피해로 바꾼다."}]},{text:"",color:"gray",italic:false,extra:[{text:"물 · 심연: 주변 3.5칸의 적을 대상 쪽으로 끌어당기고 물 피해."}]},{text:"",color:"gray",italic:false,extra:[{text:"번개 · 단죄: 붉은 낙뢰. 잠식이 높을수록 피해 증가, 원소 입자 1개."}]},{text:"",color:"gray",italic:false,extra:[{text:"얼음 · 서리 파편: 파편 5개가 주변 적에게 꽂힌다(적이 없으면 휘어서 대상에게)."}]},{text:"",color:"gray",italic:false,extra:[{text:"    파편마다 얼음 피해 + 잠식 5%."}]},{text:"",color:"gray",italic:false,extra:[{text:"바위 · 공허 결정: 주우면 방어막 + 공허 잔향 1칸."}]},{text:"",color:"gray",italic:false,extra:[{text:"바람 · 진공: 주변 3칸의 적에게 대상 잠식의 40%를 더하고 공허 부착."}]},{text:"",color:"gray",italic:false,extra:[{text:"풀 · 공허 개화: 작은 풀 폭발. 잔향이 「만개 잔향」이 된다."}]}]}
