# 아바타 손의 무기는 원래 모델로(rlk:h/* → 원래). @s = 아무나
execute if items entity @e[tag=rlk_av,limit=1] weapon.mainhand *[minecraft:item_model="rlk:h/iron_sword"] run item modify entity @e[tag=rlk_av,limit=1] weapon.mainhand {type:"minecraft:set_components",components:{"minecraft:item_model":"minecraft:iron_sword"}}
